{
  "10": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{REFERENCE_IMAGE}}"
    },
    "_meta": {
      "title": "Character Sheet Reference",
      "role": "reference"
    }
  },
  "11": {
    "class_type": "PulidFluxModelLoader",
    "inputs": {
      "pulid_file": "pulid_flux_v0.9.safetensors"
    },
    "_meta": { "title": "Load PuLID Flux Model" }
  },
  "12": {
    "class_type": "PulidFluxEvaClipLoader",
    "inputs": {},
    "_meta": { "title": "Load EVA CLIP" }
  },
  "13": {
    "class_type": "PulidFluxInsightFaceLoader",
    "inputs": {
      "provider": "CPU"
    },
    "_meta": { "title": "Load InsightFace for PuLID" }
  },
  "20": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "flux1-dev.safetensors",
      "weight_dtype": "default"
    },
    "_meta": { "title": "Load Flux UNet" }
  },
  "21": {
    "class_type": "DualCLIPLoader",
    "inputs": {
      "clip_name1": "clip_l.safetensors",
      "clip_name2": "t5xxl_fp16.safetensors",
      "type": "flux"
    },
    "_meta": { "title": "Load Flux CLIP" }
  },
  "22": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ae.safetensors"
    },
    "_meta": { "title": "Load VAE" }
  },
  "23": {
    "class_type": "ApplyPulidFlux",
    "inputs": {
      "model": ["20", 0],
      "pulid_flux": ["11", 0],
      "eva_clip": ["12", 0],
      "face_analysis": ["13", 0],
      "image": ["10", 0],
      "weight": "{{PULID_WEIGHT}}",
      "start_at": 0.0,
      "end_at": 1.0
    },
    "_meta": { "title": "Apply Character Identity (PuLID)" }
  },
  "30": {
    "class_type": "CLIPTextEncodeFlux",
    "inputs": {
      "clip": ["21", 0],
      "clip_l": ["21", 1],
      "t5xxl": ["21", 2],
      "guidance": 3.5,
      "text": "{{PROMPT}}"
    },
    "_meta": { "title": "Scene Prompt", "role": "positive" }
  },
  "31": {
    "class_type": "CLIPTextEncodeFlux",
    "inputs": {
      "clip": ["21", 0],
      "clip_l": ["21", 1],
      "t5xxl": ["21", 2],
      "guidance": 3.5,
      "text": "{{NEGATIVE_PROMPT}}"
    },
    "_meta": { "title": "Negative Prompt", "role": "negative" }
  },
  "40": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 768,
      "height": 1344,
      "batch_size": 1
    }
  },
  "41": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "{{SEED}}",
      "steps": 28,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1,
      "model": ["23", 0],
      "positive": ["30", 0],
      "negative": ["31", 0],
      "latent_image": ["40", 0]
    },
    "_meta": { "title": "Identity-Conditioned Sampler" }
  },
  "42": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["41", 0],
      "vae": ["22", 0]
    }
  },
  "43": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "scene_identity_pulid",
      "images": ["42", 0]
    }
  }
}
