# Copy this file to .env and fill in your values

# MongoDB Connection
MONGODB_URI=your_mongodb_connection_string_here
# At least 32 random characters (openssl rand -hex 32). The server refuses to start without it.
JWT_SECRET=your_jwt_secret_key_here
# Keys the one-way hashes kept after an account is deleted and the visitor-address hashes. Required in production
# (at least 32 random characters); in development it is derived from JWT_SECRET when not set.
HASH_PEPPER=
# Local development only: 1 lets "demo:<email>" tokens sign in without a password or database. Ignored in production.
ALLOW_DEMO_AUTH=
# One-time first-Owner setup through /api/admin (ADMIN_EMAIL / ADMIN_PASSWORD): set to 1 only for that step, then
# remove it. The door also closes itself once an Owner exists.
ALLOW_ADMIN_BOOTSTRAP=
# Sign-in lockout per email + address (defaults shown; docs/superpowers/ops/security-hardening.md section 10)
# LOGIN_DELAY_BASE_MS=1000
# LOGIN_IP_LOCK_AFTER=5
# LOGIN_IP_LOCK_MINUTES=15
# LOGIN_ACCOUNT_CEILING=30
# LOGIN_SEEN_DAYS=90
# LOGIN_CHALLENGE=off
# Crash policy: log only instead of restarting on an unhandled promise rejection
# UNHANDLED_REJECTION_POLICY=log
# CRASH_GRACE_MS=5000
# CRASH_DRAIN_MS=10000
JWT_EXPIRES_IN=7d
PORT=5000

# Google/YouTube OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/social/youtube/callback
FRONTEND_URL=http://localhost:3000

# Groq AI Chatbot
GROQ_API_KEY=your_groq_api_key_here
SMTP_EMAIL=
SMTP_PASSWORD=

# AI Video pipeline safety (prevents "infinite loading" on merge steps)
# Download timeout per media asset (ms)
AI_VIDEO_MEDIA_DOWNLOAD_TIMEOUT_MS=180000
# Hard cap per downloaded asset (bytes)
AI_VIDEO_MEDIA_MAX_DOWNLOAD_BYTES=786432000
# ffmpeg execution timeout per command (ms)
AI_VIDEO_FFMPEG_TIMEOUT_MS=900000

# AI Video background music selection:
# - tone: use `backend/tone-audio` (existing behavior)
# - library: use `backend/music/<15s|30s|45s|60s>[/<tone>]`
AI_VIDEO_MUSIC_SOURCE=library

# AI Video generation fallback (if Fal.ai fails)
# Set to 'true' to allow FFmpeg to generate a static clip instead of failing.
VIDEO_FALLBACK_ALLOWED=true

# CORS — extra origins to whitelist beyond the baseline hardcoded list.
# Comma-separated. Useful for new AWS ALB DNS names, temporary preview
# URLs, or partner integrations without needing a code change + rebuild.
# Example: CORS_ALLOWED_ORIGINS=https://foo.example.com,https://bar.example.com
CORS_ALLOWED_ORIGINS=

# Gravity Hero video (Seedance 2.0 via fal.ai)
# FAL_KEY is REQUIRED for hero video generation; requests fail without it.
FAL_KEY=your_fal_api_key_here
# Per-client monthly cap on hero clips (default: 2)
HERO_VIDEO_MONTHLY_LIMIT=2
# Optional model overrides (leave unset to use the defaults)
# Default: bytedance/seedance-2.0/text-to-video
FAL_HERO_TEXT_MODEL=
# Default: bytedance/seedance-2.0/reference-to-video
FAL_HERO_REF_MODEL=

# --- Text AI models (optional; leave unset to use the defaults) ---
# Comma separated Gemini text models, first is tried first. Replaces the default list
# (gemini-3.5-flash-lite, GEMINI_PRO_MODEL, gemini-2.5-flash, gemini-2.5-flash-lite).
# A model Google reports as missing or "no longer available to new users" is skipped until restart.
# Image models are separate and not affected by this setting.
GEMINI_TEXT_MODELS=
# The "pro" slot in the default list (default: gemini-2.5-pro)
GEMINI_PRO_MODEL=
# Content strategy falls back to OpenAI text when no Gemini model works (needs OPENAI_API_KEY). Default: gpt-4.1-mini
OPENAI_TEXT_MODEL=

# ---------------------------------------------------------------------------------------------------------------
# Scaling, security and hardening switches (2026-10-20). All optional: the values shown are the defaults, so leave
# them commented unless you need a change. Details: docs/superpowers/ops/ecs-web-worker.md and security-hardening.md.
# ---------------------------------------------------------------------------------------------------------------
# Role of this process. Not set = one task does everything; 0 = web only (no schedulers, sweeps or queue consumers);
# 1 = the single background worker of a web/worker split.
# RUN_BACKGROUND=
# Load balancer hops in front of the API (the client address used by limits and logs). 1 = ALB only; 2 if the
# frontend nginx forwards API calls too.
# TRUST_PROXY_HOPS=1
# Rate-limit counters: memory (one task), mongo (shared across tasks) or redis (needs REDIS_URL).
# RATE_LIMIT_STORE=memory
# RATE_LIMIT_STORE_WAIT_MS=300
# on = the general per-address limiter also shares its count (one database write per request).
# RATE_LIMIT_GENERAL_SHARED=off
# Optional Redis for rate limits and Socket.IO across tasks (redis://host:6379). Without it live updates are per task.
# REDIS_URL=
# Per-user limiters (requests per window): LIMIT_<NAME>_MAX and LIMIT_<NAME>_WINDOW_MS for
# HEAVY_AI (30 / 15 min), LIGHT_AI (100 / 15 min), UPLOAD (20 / 15 min), SPEND (10 / 15 min), SCRAPE (20 / hour),
# WEBHOOK (300 / min per address), CSP_REPORT (60 / min per address). Example:
# LIMIT_HEAVY_AI_MAX=30
# LIMIT_HEAVY_AI_WINDOW_MS=900000
# Jobs per account and flow: running and waiting (the next one gets 429); jobs older than this are not counted.
# JOB_CAP_ACTIVE=2
# JOB_CAP_QUEUED=5
# JOB_CAP_STALE_HOURS=6
# Campaign image jobs run at once per worker (CAMPAIGN_IMAGE_QUEUE_CONCURRENCY is the old name, still read).
# IMAGE_JOB_CONCURRENCY=2
# VIDEO_QUEUE_CONCURRENCY=2
# off = do not start that background job in this process.
# ENABLE_IMAGE_JOB_RUNNER=on
# ENABLE_CAMPAIGN_STATUS_SYNC=on
# CAMPAIGN_STATUS_SYNC_BATCH=25
# Password hashing cost (native bcrypt), kept between 10 and 15.
# BCRYPT_ROUNDS=11
# Short in-process cache of the signed-in account for hot read routes. off = kill switch; TTL capped at 60 s.
# AUTH_CACHE=on
# AUTH_CACHE_TTL_MS=15000
# off = no cache for staff pages.
# STAFF_CACHE=on
# Sign-in challenge after this many wrong passwords when LOGIN_CHALLENGE=on (needs TURNSTILE_SECRET_KEY).
# LOGIN_CHALLENGE_AFTER=3
# Cloudflare Turnstile bot check for sign-up (and sign-in when LOGIN_CHALLENGE=on); skipped when the secret is empty.
# TURNSTILE_SECRET_KEY=
# TURNSTILE_SITE_KEY=
# Most new accounts in any 24 hours (0 = no cap).
# SIGNUPS_PER_DAY=300
# MongoDB pool per task and how long to wait for a server.
# MONGO_MAX_POOL_SIZE=20
# MONGO_MIN_POOL_SIZE=2
# MONGO_SERVER_SELECTION_TIMEOUT_MS=30000
# Whole-request limit (ms) and the 30 s answer time for ordinary routes (0 = off; generation, upload, stream and
# export routes are excluded).
# SERVER_REQUEST_TIMEOUT_MS=300000
# ROUTE_TIMEOUT_MS=30000
# On SIGTERM: stop taking new requests and give open ones this long (keep it below the ECS stopTimeout).
# SHUTDOWN_DRAIN_MS=20000
# AI spend guard: estimated daily ceiling in US dollars (alerts at 80% and 100%), and providers switched off
# (comma-separated, for example openai,fal).
# AI_DAILY_SPEND_CAP_USD=
# AI_KILLED=
# Downloads of links (services/safeFetch.js) are https only. 1 also allows http:// links (public addresses only).
# ALLOW_HTTP_FETCH=
# Container only (docker-entrypoint.sh): V8 heap in MB. The image also sets UV_THREADPOOL_SIZE=6.
# NODE_HEAP_MB=1536

# Per-campaign publish claim (double-post safety): how long one send may hold a post before another run may take it over.
# PUBLISH_CLAIM_MS=600000
